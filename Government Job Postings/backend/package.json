{
  "name": "government-job-postings",
  "version": "1.0.0",
  "description": "Hybrid web scraping + AI parsing pipeline for Indian government job portals",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sync": "node services/incrementalSync.js",
    "sync:deep": "node services/incrementalSync.js --force",
    "renormalize": "node scripts/renormalize.js",
    "test": "node test/regexParser.test.js && node test/syncBehaviour.test.js",
    "test:parser": "node test/regexParser.test.js",
    "test:sync": "node test/syncBehaviour.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.3",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5"
  }
}
